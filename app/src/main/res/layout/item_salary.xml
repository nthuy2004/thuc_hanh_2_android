<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_medium"
    android:layout_marginVertical="@dimen/padding_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <TextView
            android:id="@+id/tv_salary_employee_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textColorPrimary"
            android:textSize="@dimen/text_medium"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_salary_month_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bảng lương 10/2026"
                android:textColor="@color/textColorPrimary"
                android:textSize="@dimen/text_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_salary_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHƯA THANH TOÁN"
                android:textColor="@color/errorColor"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_salary_total_hours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng giờ: 160 giờ"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_medium" />

            <TextView
                android:id="@+id/tv_salary_overtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tăng ca: 10 giờ"
                android:textColor="@color/primaryColor"
                android:textSize="@dimen/text_medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_salary_total_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:text="17.500.000 VNĐ"
            android:textColor="@color/secondaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mark_salary_paid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:backgroundTint="@color/secondaryColor"
            android:text="Đánh dấu đã thanh toán"
            android:textColor="@color/white"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>