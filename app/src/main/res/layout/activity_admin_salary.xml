<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundColor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_admin_salary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryColor"
        app:title="Quản lý Bảng Lương"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_medium"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edt_month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tháng/Năm (VD: 10/2026)"
            android:inputType="date"/>

        <Button
            android:id="@+id/btn_generate_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo/Xem bảng lương"
            android:backgroundTint="@color/secondaryColor"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/padding_medium"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_salary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_salary"/>

</LinearLayout>